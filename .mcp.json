{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--isolated", "--browser", "chromium"]
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "--env-file",
        "${CLAUDE_PROJECT_DIR:-.}/.env",
        "--python",
        "3.12",
        "--with",
        "mcp~=1.0",
        "--overrides",
        "${CLAUDE_PROJECT_DIR:-.}/uv-overrides.txt",
        "postgres-mcp",
        "--access-mode=restricted"
      ]
    },
    "jira": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "mcp-atlassian==0.23.1",
        "--env-file",
        "${CLAUDE_PROJECT_DIR:-.}/.env",
        "--read-only",
        "--jira-projects-filter",
        "SCRUM",
        "--enabled-tools",
        "jira_get_issue,jira_search"
      ]
    }
  }
}
