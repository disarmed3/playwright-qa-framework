{
  "name": "qa-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A framework that tests the supplied course applications.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "cross-env APP_ENV=dev playwright test",
    "test:prod": "cross-env APP_ENV=prod playwright test",
    "test:list": "cross-env APP_ENV=dev playwright test --list",
    "test:safety": "cross-env APP_ENV=dev playwright test --config playwright.safety.config.ts && node --test safety-tests/vault-log.test.mjs safety-tests/guard.test.mjs safety-tests/worklog.test.mjs safety-tests/vault-sync.test.mjs safety-tests/fleet-log.test.mjs safety-tests/check-env-gates.test.mjs",
    "vault:sync": "node scripts/vault-sync.mjs --write",
    "vault:check": "node scripts/vault-sync.mjs --check",
    "vault:validate": "node scripts/vault-links.mjs",
    "test:git-hooks": "node --test safety-tests/secret-scan.test.mjs safety-tests/pre-push-check.test.mjs safety-tests/vault-git.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:env-gates": "node scripts/check-env-gates.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@codemify/qa-dashboard": "file:tools/qa-dashboard/codemify-qa-dashboard-0.1.3.tgz",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.5",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "pg": "8.23.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
