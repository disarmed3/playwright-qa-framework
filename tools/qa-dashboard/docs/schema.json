{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Dashboard configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "playwright",
    "defaultEnvironment",
    "environments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "playwright": {
      "type": "object",
      "required": ["config"],
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "string"
        }
      }
    },
    "defaultEnvironment": {
      "type": "string"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "production"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "production": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "urlEnv": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requiredEnv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pathPrefix"],
        "properties": {
          "pathPrefix": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "layer": {
            "enum": ["ui", "api", "db", "other"]
          }
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pathPrefix", "requiredEnv"],
        "properties": {
          "pathPrefix": {
            "type": "string"
          },
          "requiredEnv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "workers": {
          "enum": [1, 2, 4]
        },
        "retries": {
          "enum": [0, 1, 2]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      }
    }
  }
}
